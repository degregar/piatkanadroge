---
import { ImageMetadata } from "astro";

export async function getAlbumImages(albumId: string) {
  if (!albumId) return [];

  const images = import.meta.glob<{ default: ImageMetadata }>(
    "/src/content/albums/**/*.{jpeg,jpg,png,JPG,JPEG,PNG}",
    { eager: true }
  );

  const resolvedImages = Object.entries(images)
    .filter(([path]) => path.includes(`/albums/${albumId}/`))
    .map(([, mod]) => mod.default);

  resolvedImages.sort(() => Math.random() - 0.5);
  return resolvedImages;
}

export async function getAlbumImage(albumId: string, file: string) {
  if (!albumId || !file) return undefined;

  const basename = file.split("/").pop();

  const images = import.meta.glob<{ default: ImageMetadata }>(
    "/src/content/albums/**/*.{jpeg,jpg,png,JPG,JPEG,PNG}",
    { eager: true }
  );

  const entry = Object.entries(images).find(
    ([path]) => path.includes(`/albums/${albumId}/`) && path.endsWith(`/${basename}`)
  );

  return entry?.[1].default;
}
---
